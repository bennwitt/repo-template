# This repository intentionally versions its portable global standards even when
# a user's global Git excludes .agents and .claude directories. Only the portable
# subsets are re-included; machine-local Claude state remains ignored.
!/.agents/
/.agents/*
!/.agents/.skill-lock.json
!/.agents/skills/
!/.agents/skills/**
!/.agents/hooks/
!/.agents/hooks/**
/.agents/hooks/__pycache__/
!/.claude/
/.claude/*
!/.claude/settings.json
!/.claude/skills/
!/.claude/skills/**
