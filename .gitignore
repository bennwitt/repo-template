# >>> repo-template managed defaults
# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Test and tool caches
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Personal AI tooling is centralized outside each repository
.agents/
.claude/
.codex/
CLAUDE.local.md

# Tool state: browser sessions, saved logins and test reports, cloud environment
# settings, Foundry datasets
.playwright-cli/
.playwright-mcp/
.auth/
test-results/
playwright-report/
blob-report/
.azure/
.foundry/

# Editors and operating systems
.idea/
.DS_Store
# <<< repo-template managed defaults

# This repository versions its portable global standards even though the block above (and a
# user's global Git ignore) excludes .agents and .claude. Only the portable subsets are
# re-included; machine-local Claude state stays ignored. Keep these rules below the block:
# Git applies the last matching rule.
!/.agents/
/.agents/*
!/.agents/.skill-lock.json
!/.agents/skill-packs.json
!/.agents/mcp-servers.json
!/.agents/machine-tools.json
!/.agents/skill-overrides.json
!/.agents/claude-settings.json
!/.agents/skill-sources.json
!/.agents/licenses/
!/.agents/licenses/**
!/.agents/skills/
!/.agents/skills/**
!/.agents/packs/
!/.agents/packs/**
# Caches a skill's scripts leave behind when they run in place (the links point here).
/.agents/skills/**/__pycache__/
/.agents/skills/**/*.py[cod]
/.agents/skills/**/.DS_Store
/.agents/skills/**/.ruff_cache/
/.agents/packs/**/__pycache__/
/.agents/packs/**/*.py[cod]
/.agents/packs/**/.DS_Store
/.agents/packs/**/.ruff_cache/
# A `globals --upgrade` staging folder; removed when the upgrade ends or the next one starts.
/.repo-template-upgrade-*/
!/.agents/hooks/
!/.agents/hooks/**
/.agents/hooks/__pycache__/
!/.claude/
/.claude/*
!/.claude/skills/
!/.claude/skills/**
