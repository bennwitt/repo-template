{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sync dependencies",
      "type": "shell",
      "command": "uv sync --dev",
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "uv run pytest",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "uv run ruff check .",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Type check",
      "type": "shell",
      "command": "uv run mypy src",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
