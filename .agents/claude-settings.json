{
  "portable": {
    "enabledPlugins": {
      "atlassian@claude-plugins-official": true,
      "azure@claude-plugins-official": false,
      "chrome-devtools-mcp@claude-plugins-official": true,
      "claude-code-setup@claude-plugins-official": true,
      "github@claude-plugins-official": false,
      "greptile@claude-plugins-official": true,
      "hookify@claude-plugins-official": true,
      "mcp-apps@claude-plugins-official": false,
      "mcp-server-dev@claude-plugins-official": false,
      "microsoft-docs@claude-plugins-official": true,
      "playwright@claude-plugins-official": false,
      "pyright-lsp@claude-plugins-official": true,
      "remember@claude-plugins-official": true,
      "skill-creator@claude-plugins-official": true,
      "sourcegraph@claude-plugins-official": false,
      "typescript-lsp@claude-plugins-official": true
    },
    "env": {
      "AZURE_MCP_COLLECT_TELEMETRY": "false",
      "AZURE_DEV_COLLECT_TELEMETRY": "no",
      "BROWSERBASE_TELEMETRY_DISABLED": "1",
      "BROWSE_DISABLE_UPDATE_CHECK": "1"
    },
    "permissions": {
      "deny": [
        "Read(./**/.env)",
        "Read(./**/.env.*)",
        "Read(./secrets/**)",
        "Read(./**/*.pem)",
        "Read(./**/*.key)",
        "mcp__playwright__browser_run_code_unsafe",
        "mcp__plugin_playwright_playwright__browser_run_code_unsafe",
        "mcp__figma__add_code_connect_map",
        "mcp__figma__create_generative_plugin",
        "mcp__figma__create_new_file",
        "mcp__figma__create_shader",
        "mcp__figma__generate_diagram",
        "mcp__figma__generate_figma_design",
        "mcp__figma__generate_image",
        "mcp__figma__generate_vector_illustration",
        "mcp__figma__html_to_figma",
        "mcp__figma__send_code_connect_mappings",
        "mcp__figma__send_code_to_figma",
        "mcp__figma__update_generative_plugin",
        "mcp__figma__update_shader",
        "mcp__figma__upload_assets",
        "mcp__figma__use_figma",
        "mcp__*__weave_upload_asset",
        "mcp__*__weave_run_tool",
        "mcp__*__weave_cancel_tool_run",
        "mcp__*__weave_run_model",
        "mcp__*__submit_feedback"
      ],
      "ask": [
        "Bash(docker *system prune*)",
        "Bash(docker *image prune*)",
        "Bash(docker *container prune*)",
        "Bash(docker *volume prune*)",
        "Bash(docker *volume rm *)",
        "Bash(docker *network prune*)",
        "Bash(docker *builder prune*)",
        "Bash(docker *buildx prune*)",
        "Bash(docker *rmi *)",
        "Bash(docker *image rm *)",
        "Bash(docker compose *down*-v*)",
        "Bash(docker compose *rm *-v*)",
        "Bash(playwright-cli *run-code*)",
        "Bash(npx playwright cli *run-code*)",
        "mcp__playwright-unsafe__browser_run_code_unsafe",
        "mcp__figma-write__add_code_connect_map",
        "mcp__figma-write__create_generative_plugin",
        "mcp__figma-write__create_new_file",
        "mcp__figma-write__create_shader",
        "mcp__figma-write__generate_diagram",
        "mcp__figma-write__generate_figma_design",
        "mcp__figma-write__generate_image",
        "mcp__figma-write__generate_vector_illustration",
        "mcp__figma-write__html_to_figma",
        "mcp__figma-write__send_code_connect_mappings",
        "mcp__figma-write__send_code_to_figma",
        "mcp__figma-write__update_generative_plugin",
        "mcp__figma-write__update_shader",
        "mcp__figma-write__upload_assets",
        "mcp__figma-write__use_figma",
        "mcp__plugin_figma_figma__add_code_connect_map",
        "mcp__plugin_figma_figma__create_generative_plugin",
        "mcp__plugin_figma_figma__create_new_file",
        "mcp__plugin_figma_figma__create_shader",
        "mcp__plugin_figma_figma__generate_diagram",
        "mcp__plugin_figma_figma__generate_figma_design",
        "mcp__plugin_figma_figma__generate_image",
        "mcp__plugin_figma_figma__generate_vector_illustration",
        "mcp__plugin_figma_figma__html_to_figma",
        "mcp__plugin_figma_figma__send_code_connect_mappings",
        "mcp__plugin_figma_figma__send_code_to_figma",
        "mcp__plugin_figma_figma__update_generative_plugin",
        "mcp__plugin_figma_figma__update_shader",
        "mcp__plugin_figma_figma__upload_assets",
        "mcp__plugin_figma_figma__use_figma",
        "Bash(az * delete*)",
        "Bash(az * purge*)",
        "Bash(az ad app permission admin-consent*)",
        "Bash(az ad * credential reset*)",
        "Bash(az role assignment create*)",
        "Bash(az * keys list*)",
        "Bash(az acr credential show*)",
        "Bash(azd up*)",
        "Bash(azd provision*)",
        "Bash(azd deploy*)",
        "Bash(azd down*)",
        "Bash(terraform apply*)",
        "Bash(terraform destroy*)",
        "Bash(kubectl debug*)",
        "Bash(kubectl delete*)",
        "Bash(kubectl drain*)",
        "Bash(azd extension install*)",
        "Bash(az extension add*)"
      ]
    },
    "hooks": {
      "PostToolUse": [
        {
          "matcher": "Skill",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"$HOME/.agents/hooks/skill_receipt.py\" 2>/dev/null || true"
            }
          ]
        }
      ],
      "UserPromptExpansion": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"$HOME/.agents/hooks/skill_receipt.py\" 2>/dev/null || true"
            }
          ]
        }
      ]
    }
  },
  "defaults": {
    "model": "opus[1m]",
    "effortLevel": "xhigh",
    "theme": "auto",
    "agentPushNotifEnabled": true
  },
  "linked": {
    "enabledPlugins": {
      "skill-creator@claude-plugins-official": true,
      "playwright@claude-plugins-official": true,
      "github@claude-plugins-official": true,
      "claude-code-setup@claude-plugins-official": true,
      "pyright-lsp@claude-plugins-official": true,
      "chrome-devtools-mcp@claude-plugins-official": true,
      "atlassian@claude-plugins-official": true,
      "hookify@claude-plugins-official": true,
      "remember@claude-plugins-official": true,
      "greptile@claude-plugins-official": true,
      "mcp-server-dev@claude-plugins-official": true,
      "microsoft-docs@claude-plugins-official": true,
      "sourcegraph@claude-plugins-official": true,
      "azure@claude-plugins-official": true,
      "mcp-apps@claude-plugins-official": true
    },
    "permissions": {
      "deny": [
        "Read(./.env)",
        "Read(./.env.*)",
        "Read(./secrets/**)",
        "Read(./**/*.pem)",
        "Read(./**/*.key)"
      ]
    },
    "hooks": {
      "PostToolUse": [
        {
          "matcher": "Skill",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"$HOME/.agents/hooks/skill_receipt.py\" 2>/dev/null || true"
            }
          ]
        }
      ],
      "UserPromptExpansion": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"$HOME/.agents/hooks/skill_receipt.py\" 2>/dev/null || true"
            }
          ]
        }
      ]
    }
  }
}
