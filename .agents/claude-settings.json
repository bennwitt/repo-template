{
  "portable": {
    "enabledPlugins": {
      "atlassian@claude-plugins-official": true,
      "azure@claude-plugins-official": false,
      "chrome-devtools-mcp@claude-plugins-official": true,
      "claude-code-setup@claude-plugins-official": true,
      "github@claude-plugins-official": true,
      "greptile@claude-plugins-official": true,
      "hookify@claude-plugins-official": true,
      "mcp-apps@claude-plugins-official": false,
      "mcp-server-dev@claude-plugins-official": false,
      "microsoft-docs@claude-plugins-official": true,
      "playwright@claude-plugins-official": false,
      "pyright-lsp@claude-plugins-official": true,
      "remember@claude-plugins-official": true,
      "skill-creator@claude-plugins-official": true,
      "sourcegraph@claude-plugins-official": false,
      "typescript-lsp@claude-plugins-official": true
    },
    "env": {
      "AZURE_MCP_COLLECT_TELEMETRY": "false",
      "AZURE_DEV_COLLECT_TELEMETRY": "no"
    },
    "permissions": {
      "deny": [
        "Read(./**/.env)",
        "Read(./**/.env.*)",
        "Read(./secrets/**)",
        "Read(./**/*.pem)",
        "Read(./**/*.key)",
        "mcp__*__browser_run_code_unsafe",
        "mcp__*__submit_feedback"
      ],
      "ask": [
        "Bash(docker *system prune*)",
        "Bash(docker *image prune*)",
        "Bash(docker *container prune*)",
        "Bash(docker *volume prune*)",
        "Bash(docker *volume rm *)",
        "Bash(docker *network prune*)",
        "Bash(docker *builder prune*)",
        "Bash(docker *buildx prune*)",
        "Bash(docker *rmi *)",
        "Bash(docker *image rm *)",
        "Bash(docker compose *down*-v*)",
        "Bash(docker compose *rm *-v*)",
        "Bash(playwright-cli *run-code*)",
        "Bash(npx playwright cli *run-code*)",
        "Bash(az * delete*)",
        "Bash(az * purge*)",
        "Bash(az ad app permission admin-consent*)",
        "Bash(az ad * credential reset*)",
        "Bash(az role assignment create*)",
        "Bash(az * keys list*)",
        "Bash(az acr credential show*)",
        "Bash(azd up*)",
        "Bash(azd provision*)",
        "Bash(azd deploy*)",
        "Bash(azd down*)",
        "Bash(terraform apply*)",
        "Bash(terraform destroy*)",
        "Bash(kubectl debug*)",
        "Bash(kubectl delete*)",
        "Bash(kubectl drain*)",
        "Bash(azd extension install*)",
        "Bash(az extension add*)"
      ]
    },
    "hooks": {
      "PostToolUse": [
        {
          "matcher": "Skill",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"$HOME/.agents/hooks/skill_receipt.py\" 2>/dev/null || true"
            }
          ]
        }
      ],
      "UserPromptExpansion": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"$HOME/.agents/hooks/skill_receipt.py\" 2>/dev/null || true"
            }
          ]
        }
      ]
    }
  },
  "defaults": {
    "model": "opus[1m]",
    "effortLevel": "xhigh",
    "theme": "auto",
    "agentPushNotifEnabled": true
  },
  "linked": {
    "enabledPlugins": {
      "skill-creator@claude-plugins-official": true,
      "playwright@claude-plugins-official": true,
      "github@claude-plugins-official": true,
      "claude-code-setup@claude-plugins-official": true,
      "pyright-lsp@claude-plugins-official": true,
      "chrome-devtools-mcp@claude-plugins-official": true,
      "atlassian@claude-plugins-official": true,
      "hookify@claude-plugins-official": true,
      "remember@claude-plugins-official": true,
      "greptile@claude-plugins-official": true,
      "mcp-server-dev@claude-plugins-official": true,
      "microsoft-docs@claude-plugins-official": true,
      "sourcegraph@claude-plugins-official": true,
      "azure@claude-plugins-official": true,
      "mcp-apps@claude-plugins-official": true
    },
    "permissions": {
      "deny": [
        "Read(./.env)",
        "Read(./.env.*)",
        "Read(./secrets/**)",
        "Read(./**/*.pem)",
        "Read(./**/*.key)"
      ]
    },
    "hooks": {
      "PostToolUse": [
        {
          "matcher": "Skill",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"$HOME/.agents/hooks/skill_receipt.py\" 2>/dev/null || true"
            }
          ]
        }
      ],
      "UserPromptExpansion": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"$HOME/.agents/hooks/skill_receipt.py\" 2>/dev/null || true"
            }
          ]
        }
      ]
    }
  }
}
